# Copy to .env.local. Never commit real keys.
# Server-only secrets must not use a NEXT_PUBLIC_ prefix.

# grok (default), anthropic, or mock.
# Grok runs when XAI_API_KEY is set. With no key, the app stays in mock mode.
AI_PROVIDER=grok

# xAI Grok. Read only on the server. Sent only to https://api.x.ai.
XAI_API_KEY=
# Optional. Defaults to grok-4.3.
XAI_MODEL=grok-4.3

# Used only when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Public origin. The Paystack callback is this origin plus /api/paystack/callback.
NEXT_PUBLIC_SITE_URL=https://proresumetailor.com
# Public support inbox shown in the footer, pricing, and payment-failure copy.
# An invalid value falls back to alphahublimited@gmail.com.
NEXT_PUBLIC_SUPPORT_EMAIL=alphahublimited@gmail.com
# Optional. When set, the root layout loads GA4 through gtag.js. No default ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional. When set, the root metadata includes this Google Search Console token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# The ₦9,900 pack checks out with Paystack when both keys below are set.
# polar stays an unwired stub.
PAYMENT_PROVIDER=paystack

# Server-only. Used for initialize, verify, and the webhook HMAC.
PAYSTACK_SECRET_KEY=
# Publishable. Required together with the secret before checkout leaves the site.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Optional. Defaults to NGN. This Paystack account charges naira.
PAYSTACK_CURRENCY=NGN
# Optional. Minor units. Defaults to 990000, which is ₦9,900.
PRICE_AMOUNT_MINOR=990000

# Not read yet. Reserved for the unwired Polar stub.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=

# Anonymous preview balance stored in a cookie only when Supabase is unset. Default 5.
LOCAL_CREDITS_START=5

# Supabase Auth (email and password). Publishable key only in the browser.
# SUPABASE_SERVICE_ROLE_KEY is server-only. It records payments and credit balances.
# Never prefix the service role key with NEXT_PUBLIC_.
# Leave the public values empty to keep the build working. Signup and login still render.
# The tailor stays open. The UI does not mention missing keys.
# A newer publishable key (sb_publishable_...) can go in NEXT_PUBLIC_SUPABASE_ANON_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alias.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
