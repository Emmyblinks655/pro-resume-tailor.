# Copy to .env.local. Never commit real keys.
# Server-only. Do not prefix any secret with NEXT_PUBLIC_.

# gemini (default), anthropic, or mock.
# If the selected provider has no key, the app runs in mock mode.
AI_PROVIDER=gemini

# Google Gemini. Read only on the server.
GEMINI_API_KEY=
# Free-tier Flash model as of November 2026.
GEMINI_MODEL=gemini-3.8-flash

# Used only when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# polar (default) or paystack. Both adapters are stubs.
PAYMENT_PROVIDER=polar

# Not read yet. Reserved for the live Polar adapter.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=

# Not read yet. Reserved for the live Paystack adapter.
PAYSTACK_SECRET_KEY=

# Anonymous preview balance stored in a cookie. Default 5.
LOCAL_CREDITS_START=5

# Supabase Auth (email and password). Publishable key only.
# The service role key is not used and must not be added as NEXT_PUBLIC_.
# Leave both empty to keep the build working. Signup and login still render.
# The tailor stays open. The UI does not mention missing keys.
# A newer publishable key (sb_publishable_...) can go in NEXT_PUBLIC_SUPABASE_ANON_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alias.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
