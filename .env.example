# Copy to .env.local. Never commit real keys.
# Server-only. Do not prefix any secret with NEXT_PUBLIC_.

# gemini (default), anthropic, or mock.
# If the selected provider has no key, the app runs in mock mode.
AI_PROVIDER=gemini

# Google Gemini. Read only on the server.
GEMINI_API_KEY=
# Free-tier Flash model as of November 2026.
GEMINI_MODEL=gemini-3.8-flash

# Used only when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# polar (default) or paystack. Both adapters are stubs.
PAYMENT_PROVIDER=polar

# Not read yet. Reserved for the live Polar adapter.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=

# Not read yet. Reserved for the live Paystack adapter.
PAYSTACK_SECRET_KEY=

# Anonymous preview balance stored in a cookie. Default 5.
LOCAL_CREDITS_START=5

# Sign In with LinkedIn using OpenID Connect (scopes: openid profile email).
# Create an app at https://www.linkedin.com/developers/apps
# Add the product "Sign In with LinkedIn using OpenID Connect".
# Authorized redirect URL:
#   https://pro-resume-tailor.vercel.app/api/auth/linkedin/callback
# Leave the client id and secret empty to show "LinkedIn connect not configured yet".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional override. Defaults to this site's origin + /api/auth/linkedin/callback.
# For local sign-in, register http://localhost:3000/api/auth/linkedin/callback on the LinkedIn app
# and set it here.
# LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
# PKCE is on by default (state and nonce are always checked). Set to 0 if LinkedIn returns
# "Open ID permission is not supported for PKCE flows".
# LINKEDIN_PKCE=1

# 32-byte key used to encrypt LinkedIn tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Hex (64 characters) is also accepted. A short passphrase is rejected.
# Required before a connection can be stored.
TOKEN_ENCRYPTION_KEY=

# Optional LinkedIn connection store. When both are set, rows go in public.linkedin_connections.
# Apply supabase/migrations/20261112233000_linkedin_connections.sql first.
# The access token is encrypted before insert. The service role is server-only.
# Without both values, the connection is stored in an encrypted httpOnly cookie.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL is also accepted as the project URL.
# The anon key is not used. Browser roles have no grant on linkedin_connections.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
